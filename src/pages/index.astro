---
import { getCollection } from "astro:content"
import { projects } from "@/data/projects"
import IndexLayout from "@/layouts/index.astro"
import { ArrowRight } from "lucide-react"
import { Button } from "@/components/ui/button"
import { PostCardWrapper } from "@/components/wrapper/PostCardWrapper"
import { MomentCardWrapper } from "@/components/wrapper/MomentCardWrapper"
import { ProjectWrapper } from "@/components/wrapper/ProjectWrapper"

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
const latestPosts = posts.slice(0, 6)

const moments = (await getCollection("moments")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
const latestMoments = moments.slice(0, 4)
---

<IndexLayout title="落秋cc">
  <!-- Project -->
  <div>
    <h3 class="mt-12 mb-8 scroll-m-20 text-2xl font-semibold tracking-tight">
      小玩具
    </h3>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <ProjectWrapper projects={projects} />
    </div>
    <div class="my-4">
      <!-- <a href="https://github.com/luoqiucc?tab=repositories" target="_blank">
        <Button>
          查看更多 <ArrowRight />
        </Button>
      </a> -->
    </div>
  </div>

  <!-- Blog -->
  <div>
    <h3 class="mt-12 mb-8 scroll-m-20 text-2xl font-semibold tracking-tight">
      最新博客
    </h3>
    <div class="grid grid-cols-1 gap-4">
      <PostCardWrapper posts={latestPosts} />
    </div>
    <div class="my-4">
      <a href="/post/1">
        <Button>
          查看更多 <ArrowRight />
        </Button>
      </a>
    </div>
  </div>

  <!-- Moment -->
  <div>
    <h3 class="mt-12 mb-8 scroll-m-20 text-2xl font-semibold tracking-tight">
      最新动态
    </h3>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <MomentCardWrapper moments={latestMoments} />
    </div>
    <div class="my-4">
      <a href="/moment/1">
        <Button>
          查看更多 <ArrowRight />
        </Button>
      </a>
    </div>
  </div>
</IndexLayout>
