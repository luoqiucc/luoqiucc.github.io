---
import { getCollection, render } from "astro:content"
import { formatCategory, formatDateCN } from "@/lib/utils"
import PostLayout from "@/layouts/post.astro"
import { Badge } from "@/components/ui/badge"
import { CoverImage } from "@/components/CoverCard"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<PostLayout title={post.data.title}>
  <div class="my-16">
    <div class="my-4 flex justify-center">
      <a href={`/post/${post.data.category}/1`}>
        <Badge variant="secondary">{formatCategory(post.data.category)}</Badge>
      </a>
    </div>
    <h1
      class="my-4 scroll-m-20 text-center text-4xl font-extrabold tracking-tight"
    >
      {post.data.title}
    </h1>
    <p class="my-4 text-center text-xl text-muted-foreground">
      {post.data.subtitle}
    </p>
    <p class="my-4 text-center text-sm text-muted-foreground">
      {formatDateCN(post.data.pubDate)}
    </p>
  </div>
  <div class="my-16">
    <CoverImage url={post.data.cover} />
  </div>
  <div class="my-16">
    <blockquote class="border-l-2 pl-6 italic">
      &quot;{post.data.abstract}&quot;
    </blockquote>
  </div>
  <div class="typeset typeset-article">
    <Content />
  </div>
</PostLayout>
