---
import type { GetStaticPathsOptions } from "astro"
import { getCollection } from "astro:content"
import IndexLayout from "@/layouts/index.astro"
import { PostPagination } from "@/components/PostPagination"
import { PostCardWrapper } from "@/components/wrapper/PostCardWrapper"

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const computerNetworks = (
    await getCollection("posts", ({ data }) => {
      return data.category == "computer-networks"
    })
  ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

  return paginate(computerNetworks, { pageSize: 12 })
}

const { page } = Astro.props
---

<IndexLayout title="计算机网络">
  <h1 class="mt-12 mb-8 scroll-m-20 text-2xl font-semibold tracking-tight">
    计算机网络
  </h1>
  <div class="grid grid-cols-1 gap-4">
    <PostCardWrapper posts={page.data} />
  </div>
  <div class="my-8">
    <PostPagination page={page} category="post/computer-networks" />
  </div>
</IndexLayout>
